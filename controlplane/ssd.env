# Existing media SSD; never format or repartition this disk.
ETCD_SSD_UUID=F0F7-DB96
ETCD_SSD_MEDIA=/var/lib/arr-stack/media
ETCD_SSD_IMAGE=/var/lib/arr-stack/media/.kubernetes-storage/etcd.luks
ETCD_SSD_KEY=/var/lib/minikube/controlplane/etcd-ssd.key
ETCD_SSD_TARGET=/var/lib/minikube/etcd-ssd
ETCD_SSD_MAPPING=fabkli-etcd
